rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: User must be authenticated
    function signedIn() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.grandfathered == true ||
        request.auth.token.firebase.sign_in_provider != 'password'
      );
    }

    // Helper: System Admin Check
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@rupeo.app' ||
        request.auth.token.email == 'ya041304@gmail.com'
      );
    }

    // Helper: Validates minimized transaction payload with size limits & strict field constraints
    function isValidTransaction(data) {
      return data.keys().hasOnly([
        'id', 'amount', 'type', 'category', 'date', 'payee', 'note', 'source', 'updatedAt', 'created_at', 'updated_at'
      ])
      // Deny any forbidden sensitive fields explicitly
      && !data.keys().hasAny([
        'ref_no', 'utr', 'accountLast4', 'account_last4', 'account_no',
        'bank_name', 'bank', 'raw_body', 'original_message', 'package_name',
        'notif_log', 'diagnostics', 'sourceHash', 'payKey'
      ])
      // Id validation (max 128 chars)
      && data.id is string && data.id.size() > 0 && data.id.size() <= 128
      // Amount validation (positive number, up to 100 crore)
      && data.amount is number && data.amount >= 0 && data.amount <= 1000000000
      // Type validation
      && data.type is string && data.type in ['debit', 'credit', 'expense', 'income']
      // Category validation (max 60 chars)
      && data.category is string && data.category.size() > 0 && data.category.size() <= 60
      // Date validation (strictly YYYY-MM-DD, 10 chars)
      && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
      // Optional payee validation (max 100 chars)
      && (!('payee' in data) || data.payee == null || (data.payee is string && data.payee.size() <= 100))
      // Optional user note validation (max 500 chars)
      && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500))
      // Source validation ('auto' | 'manual' | 'statement')
      && (!('source' in data) || data.source == null || (data.source is string && data.source in ['auto', 'manual', 'statement']))
      // Timestamp validation
      && (!('updatedAt' in data) || data.updatedAt is number || data.updatedAt is timestamp);
    }

    // Deny-all client rule for email_otps (Admin SDK only)
    match /email_otps/{document=**} {
      allow read, write: if false;
    }

    // App Global Config (Read: public, Write: Admin)
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'used_count', 'redeemedUsers'])
      );
    }

    // Support Messages
    match /support_messages/{messageId} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'topic', 'message', 'source', 'userId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() <= 3000
        && request.resource.data.source is string && request.resource.data.source.size() <= 50
        && request.resource.data.status is string && request.resource.data.status in ['open', 'unread']
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 50
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 50
        && (!('phone' in request.resource.data) || request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && (!('topic' in request.resource.data) || request.resource.data.topic == null || (request.resource.data.topic is string && request.resource.data.topic.size() <= 100))
        && (!('userId' in request.resource.data) || request.resource.data.userId == null || (request.resource.data.userId is string && request.resource.data.userId.size() <= 128))
      );
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Admin Notifications
    match /admin_notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.active == true);
      allow create, update, delete: if isAdmin();
    }

    // USER DATA ISOLATION: A user can read/write ONLY their own document tree
    match /users/{userId} {
      // User Profile document
      allow read: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['is_premium', 'premium_plan', 'premium_activated_at']);
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_premium', 'premium_plan', 'premium_activated_at']);

      // 1. Minimized Transactions Subcollection
      match /transactions/{transactionId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId && isValidTransaction(request.resource.data);
      }

      // 2. Settings Subcollection
      match /settings/{settingsId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['isPremium', 'premiumPlan', 'premiumActivatedAt']);
      }

      // 3. User Categories Subcollection
      match /categories/{categoryId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // 4. Recurring Bills Subcollection
      match /recurring_bills/{billId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // 5. Notifications & Devices Subcollections
      match /notifications/{notificationId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // 6. Friends / Udhar Ledger Subcollection
      match /friends/{friendId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Catch-all for any other user-scoped subcollections: strictly owner only
      match /{subcollection}/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId && subcollection != 'settings';
      }
    }

    // Ads collection
    match /ads/{adId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicksCount', 'impressionsCount', 'updatedAt'])
      );
    }
  }
}
