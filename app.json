{
  "expo": {
    "name": "Rupeo",
    "slug": "PaiseWaise",
    "version": "2.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rupeo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.innovatexlabs.paisewaise",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Rupeo needs access to your contacts to quickly add friends and track loans."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F11",
        "foregroundImage": "./assets/images/icon.png"
      },
      "versionCode": 30,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING",
        "android.permission.READ_CONTACTS"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.innovatexlabs.paisewaise",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.innovatexlabs.paisewaise",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads/app.plugin.js",
        {
          "androidAppId": "ca-app-pub-2106211536803561~5812952031",
          "iosAppId": "ca-app-pub-2106211536803561~5812952031"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F11"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.reactnativeandroidwidget.** { *; }\n-keep class * extends com.reactnativeandroidwidget.RNWidgetProvider { *; }\n-keep class expo.modules.speechrecognition.** { *; }\n-keepclassmembers class expo.modules.speechrecognition.** { *; }\n-dontwarn expo.modules.speechrecognition.**\n-keep class android.speech.** { *; }\n-keep interface android.speech.** { *; }\n-keep class com.innovatexlabs.paisewaise.RupeoShare** { *; }\n-keep class com.innovatexlabs.paisewaise.RupeoFileProvider { *; }\n-dontwarn com.innovatexlabs.paisewaise.**"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-contacts",
      "@react-native-community/datetimepicker",
      "./plugins/withAndroidKotlinFix",
      "./plugins/withRupeoShare",
      "expo-font",
      "expo-image",
      "expo-speech-recognition",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAddWidget",
              "label": "Rupeo Quick Add",
              "description": "Daily tracker & 1-tap quick transaction buttons",
              "minWidth": "200dp",
              "minHeight": "100dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "InsightWidget",
              "label": "Rupeo Monthly Insights",
              "description": "Monthly spend, budget progress & financial overview",
              "minWidth": "200dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickActionsWidget",
              "label": "Rupeo 1-Tap Actions",
              "description": "Compact launcher for Expense, Income, Voice & History",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withAndroidShortcuts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "318513cc-7259-4286-bc06-00cf798b1cf9"
      }
    },
    "owner": "jeetucodes"
  }
}
