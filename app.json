{
  "expo": {
    "name": "Rupeo",
    "slug": "PaiseWaise",
    "version": "2.2.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rupeo",
    "userInterfaceStyle": "light",
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#FFD740"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.innovatexlabs.paisewaise",
      "buildNumber": "38",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Rupeo needs access to your contacts to quickly add friends and track loans.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F11",
        "foregroundImage": "./assets/images/icon.png"
      },
      "versionCode": 39,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING",
        "android.permission.READ_CONTACTS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.SEND_SMS",
        "android.permission.WRITE_SMS",
        "android.permission.RECEIVE_MMS",
        "android.permission.RECEIVE_WAP_PUSH",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.innovatexlabs.paisewaise",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.innovatexlabs.paisewaise",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withNotificationListener.js",
      "expo-sqlite",
      [
        "react-native-google-mobile-ads/app.plugin.js",
        {
          "androidAppId": "ca-app-pub-2106211536803561~5812952031",
          "iosAppId": "ca-app-pub-2106211536803561~5812952031"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F11"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.reactnativeandroidwidget.** { *; }\n-keep class * extends com.reactnativeandroidwidget.RNWidgetProvider { *; }\n-keep class expo.modules.speechrecognition.** { *; }\n-keepclassmembers class expo.modules.speechrecognition.** { *; }\n-dontwarn expo.modules.speechrecognition.**\n-keep class android.speech.** { *; }\n-keep interface android.speech.** { *; }\n-keep class com.innovatexlabs.paisewaise.RupeoShare** { *; }\n-keep class com.innovatexlabs.paisewaise.RupeoFileProvider { *; }\n-keep class com.innovatexlabs.paisewaise.RupeoNotification** { *; }\n-keep class com.innovatexlabs.paisewaise.RupeoNotif** { *; }\n-dontwarn com.innovatexlabs.paisewaise.**"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFD740"
        }
      ],
      "expo-sharing",
      "expo-contacts",
      "@react-native-community/datetimepicker",
      "./plugins/withAndroidKotlinFix",
      "./plugins/withRupeoShare",
      "expo-font",
      "expo-image",
      "expo-speech-recognition",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodaySummaryWidget",
              "label": "Rupeo Today Summary",
              "description": "Today's spend & remaining daily limit",
              "minWidth": "270dp",
              "minHeight": "85dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "240dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/todaysummarywidget_preview.png"
            },
            {
              "name": "QuickAddWidget",
              "label": "Rupeo Quick Add",
              "description": "Instant 1-tap Expense, Income, Voice & Udhar",
              "minWidth": "270dp",
              "minHeight": "85dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "240dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/quickaddwidget_preview.png"
            },
            {
              "name": "MonthOverviewWidget",
              "label": "Rupeo Month Overview",
              "description": "Monthly income, expense, balance & flow bar",
              "minWidth": "260dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/monthoverviewwidget_preview.png"
            },
            {
              "name": "BudgetProgressWidget",
              "label": "Rupeo Budget Progress",
              "description": "Monthly budget tracker with dynamic alerts",
              "minWidth": "260dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/budgetprogresswidget_preview.png"
            },
            {
              "name": "RecentTransactionsWidget",
              "label": "Rupeo Recent Transactions",
              "description": "Last 5 transactions with amounts and categories",
              "minWidth": "260dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/recenttransactionswidget_preview.png"
            },
            {
              "name": "UdharSummaryWidget",
              "label": "Rupeo Friends & Udhar",
              "description": "To receive & To pay balance tracker",
              "minWidth": "260dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/udharsummarywidget_preview.png"
            },
            {
              "name": "GoalsProgressWidget",
              "label": "Rupeo Budget Goals",
              "description": "Up to 3 budget & category goals progress bars",
              "minWidth": "260dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/goalsprogresswidget_preview.png"
            },
            {
              "name": "UpcomingBillsWidget",
              "label": "Rupeo Upcoming Bills",
              "description": "Upcoming recurring bills & due date reminders",
              "minWidth": "260dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/upcomingbillswidget_preview.png"
            },
            {
              "name": "WeeklySpendingWidget",
              "label": "Rupeo Weekly Spend Chart",
              "description": "7-day daily spending bar chart with today highlight",
              "minWidth": "260dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/weeklyspendingwidget_preview.png"
            },
            {
              "name": "InsightWidget",
              "label": "Rupeo Monthly Insights",
              "description": "Monthly spend, budget progress & financial overview",
              "minWidth": "200dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/insightwidget_preview.png"
            },
            {
              "name": "QuickActionsWidget",
              "label": "Rupeo 1-Tap Actions",
              "description": "Compact launcher for Expense, Income, Voice & Udhar",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/quickactionswidget_preview.png"
            }
          ]
        }
      ],
      "./plugins/withAndroidShortcuts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb31241e-b1c9-4392-96a1-31db17645d8d"
      }
    },
    "owner": "jeetukeapp"
  }
}
